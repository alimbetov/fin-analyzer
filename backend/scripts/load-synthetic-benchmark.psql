-- Execute ONLY against an isolated local/test PostgreSQL database after Flyway V5.
-- From repository root:
-- PGOPTIONS='-c fin.simulation_load_enabled=on' \
--   psql -X -v ON_ERROR_STOP=1 -f backend/scripts/load-synthetic-benchmark.psql "$FIN_TEST_DATABASE_URL"
-- This intentionally never touches fin_fact, fin_calc or fin_diag.
BEGIN;
DO $guard$
BEGIN
    IF current_setting('fin.simulation_load_enabled', true) IS DISTINCT FROM 'on' THEN
        RAISE EXCEPTION 'Synthetic import disabled; opt in with fin.simulation_load_enabled=on';
    END IF;
END
$guard$;

\copy fin_sim.dataset (scenario_code,sector_code,profile_code,generated_version,first_month,last_month,currency_code,expected_outcome,note) FROM 'backend/src/test/resources/simulation/profiles.tsv' WITH (FORMAT csv, HEADER true, DELIMITER E'\t', NULL '')
\copy fin_sim.observation (scenario_code,source_revision,metric_code,metric_version,period_month,time_kind,measure_kind,unit_code,currency_code,source_form_code,source_field_code,value_state,numeric_value,estimate_method_ref) FROM 'backend/src/test/resources/simulation/monthly-financial-facts.tsv' WITH (FORMAT csv, HEADER true, DELIMITER E'\t', NULL '')
\copy fin_sim.expected_finding (scenario_code,source_revision,rule_code,finding_kind,expected_count) FROM 'backend/src/test/resources/simulation/golden-findings.tsv' WITH (FORMAT csv, HEADER true, DELIMITER E'\t', NULL '')
COMMIT;

SELECT scenario_code,count(*) AS points
FROM fin_sim.observation GROUP BY scenario_code ORDER BY scenario_code;
