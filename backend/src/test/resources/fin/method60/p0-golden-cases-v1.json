{
  "schemaVersion": "1.0.0",
  "dataClassification": "SYNTHETIC",
  "purpose": "Independent P0 acceptance inputs and expected contracts; not test execution evidence",
  "createdAt": "2026-11-16",
  "fixtureScope": {
    "organizationId": "demo-a",
    "currency": "KZT",
    "reportingBasis": "SEPARATE",
    "sourceTrust": "APPROVED_TEST_ONLY"
  },
  "testCases": [
    {
      "id": "P0-01",
      "p0": "P0-01",
      "kind": "contract",
      "input": {
        "requestSchemaVersion": "1.1.0",
        "knownMethod": "CON-01",
        "unknownMethod": "XYZ-999"
      },
      "expected": {
        "knownMethod": "ACCEPT",
        "unknownMethod": "REJECT_UNKNOWN_METHOD",
        "schemaVersion": "1.1.0"
      },
      "assertions": [
        "unknown method cannot be silently defaulted",
        "schema version is explicit"
      ]
    },
    {
      "id": "P0-02A",
      "p0": "P0-02",
      "kind": "outbox_idempotency",
      "input": {
        "tenant": "demo-a",
        "revision": "r1",
        "eventId": "event-777",
        "deliveries": 3,
        "profile": "BUSINESS_HEALTH"
      },
      "expected": {
        "logicalRuns": 1,
        "outboxEvents": 1,
        "duplicateDeliveriesIgnored": 2
      },
      "assertions": [
        "approval and outbox must commit atomically",
        "logical runs unique across retries"
      ]
    },
    {
      "id": "P0-02B",
      "p0": "P0-02",
      "kind": "lease_fencing",
      "input": {
        "taskId": "t1",
        "workerA": {
          "attempt": 1,
          "leaseExpired": true
        },
        "workerB": {
          "attempt": 2,
          "leaseValid": true
        }
      },
      "expected": {
        "acceptedAttempt": 2,
        "rejectedAttempt": 1,
        "publishedResults": 1
      },
      "assertions": [
        "stale worker is fenced",
        "no double publication"
      ]
    },
    {
      "id": "P0-02C",
      "p0": "P0-02",
      "kind": "idempotency_conflict",
      "input": {
        "tenant": "demo-a",
        "key": "req-1",
        "firstPayloadFingerprint": "sha256:aaa",
        "secondPayloadFingerprint": "sha256:bbb"
      },
      "expected": {
        "httpStatus": 409,
        "reason": "IDEMPOTENCY_KEY_CONFLICT"
      },
      "assertions": [
        "same key different payload cannot reuse result"
      ]
    },
    {
      "id": "P0-03A",
      "p0": "P0-03",
      "kind": "immutable_late_ml",
      "input": {
        "tenant": "demo-a",
        "factRevision": "r1",
        "coreReportId": "core-1",
        "coreRatio": "2.0000",
        "mlFactRevision": "r1",
        "mlModelVersion": "reg-1"
      },
      "expected": {
        "oldReportImmutable": true,
        "newReportParentId": "core-1",
        "newReportCoreRatio": "2.0000",
        "oldReportMode": "CORE",
        "newReportMode": "CORE_WITH_ML"
      },
      "assertions": [
        "ML cannot mutate CORE",
        "same fact and assumptions versions required"
      ]
    },
    {
      "id": "P0-03B",
      "p0": "P0-03",
      "kind": "ml_revision_mismatch",
      "input": {
        "coreFactRevision": "r1",
        "mlFactRevision": "r2"
      },
      "expected": {
        "enrichment": "REJECTED",
        "reason": "FACT_REVISION_MISMATCH"
      },
      "assertions": [
        "new report requires aligned source snapshot"
      ]
    },
    {
      "id": "P0-04A",
      "p0": "P0-04",
      "kind": "profile_readiness",
      "input": {
        "profile": "SALES_PROFITABILITY",
        "required": [
          "FIN-01",
          "PRO-03"
        ],
        "computed": [
          "FIN-01"
        ],
        "missing": [
          "PRO-03"
        ],
        "mlRequested": false
      },
      "expected": {
        "coreReadiness": "PARTIAL",
        "mlReadiness": "NOT_REQUESTED",
        "deliveredMode": "CORE"
      },
      "assertions": [
        "one method cannot make profile COMPLETE"
      ]
    },
    {
      "id": "P0-04B",
      "p0": "P0-04",
      "kind": "core_ml_failure_isolation",
      "input": {
        "profile": "BUSINESS_HEALTH",
        "required": [
          "FIN-04"
        ],
        "computed": [
          "FIN-04"
        ],
        "currentAssets": 400,
        "currentLiabilities": 200,
        "mlRequested": true,
        "mlStatus": "FAILED"
      },
      "expected": {
        "currentRatio": "2.0000",
        "coreReadiness": "COMPLETE",
        "mlReadiness": "FAILED",
        "deliveredMode": "CORE"
      },
      "assertions": [
        "ML failure cannot fail CORE"
      ]
    },
    {
      "id": "P0-04C",
      "p0": "P0-04",
      "kind": "empty_required",
      "input": {
        "profile": "UNDEFINED",
        "required": [],
        "defaultCompleteAllowed": false
      },
      "expected": {
        "coreReadiness": "BLOCKED",
        "reason": "PROFILE_REQUIREMENTS_UNDEFINED"
      },
      "assertions": [
        "empty required set must not auto-pass"
      ]
    },
    {
      "id": "P0-05A",
      "p0": "P0-05",
      "kind": "incremental_recalc",
      "input": {
        "revisionR1": {
          "revenue": 1000,
          "accountsReceivable": 100
        },
        "revisionR2": {
          "revenue": 1000,
          "accountsReceivable": 120
        },
        "nodes": {
          "CON-01": [
            "revenue"
          ],
          "CASH-01": [
            "revenue",
            "accountsReceivable"
          ]
        }
      },
      "expected": {
        "recomputed": [
          "CASH-01"
        ],
        "reused": [
          "CON-01"
        ]
      },
      "assertions": [
        "dependents recompute only on changed semantic inputs"
      ]
    },
    {
      "id": "P0-05B",
      "p0": "P0-05",
      "kind": "cycle_detection",
      "input": {
        "edges": [
          [
            "A",
            "B"
          ],
          [
            "B",
            "C"
          ],
          [
            "C",
            "A"
          ]
        ]
      },
      "expected": {
        "planStatus": "REJECTED",
        "reason": "DEPENDENCY_CYCLE"
      },
      "assertions": [
        "cannot submit cyclic DAG"
      ]
    },
    {
      "id": "P0-05C",
      "p0": "P0-05",
      "kind": "dedup_reconciliation",
      "input": {
        "currency": "KZT",
        "F02Revenue": 1000,
        "DF_SALRows": [
          600,
          400
        ],
        "SF_G01SameTransactions": 1000
      },
      "expected": {
        "canonicalRevenue": 1000,
        "reconciled": true
      },
      "assertions": [
        "same events must not count three times"
      ]
    },
    {
      "id": "P0-06A",
      "p0": "P0-06",
      "kind": "ttl_cleanup",
      "input": {
        "class": "TEMP_SIMULATION",
        "createdAt": "2026-01-01T00:00:00Z",
        "retentionDays": 30,
        "now": "2026-01-31T00:00:00Z",
        "legalHold": false,
        "publishedEvidencePinned": false
      },
      "expected": {
        "eligible": true,
        "finalState": "DONE",
        "approvedFactsDeleted": false
      },
      "assertions": [
        "delete only temp",
        "cleanup retries idempotently"
      ]
    },
    {
      "id": "P0-06B",
      "p0": "P0-06",
      "kind": "ttl_legal_hold",
      "input": {
        "class": "TEMP_SIMULATION",
        "createdAt": "2026-01-01T00:00:00Z",
        "retentionDays": 30,
        "now": "2026-02-01T00:00:00Z",
        "legalHold": true
      },
      "expected": {
        "eligible": false,
        "reason": "LEGAL_HOLD"
      },
      "assertions": [
        "legal hold blocks cleanup"
      ]
    },
    {
      "id": "P0-06C",
      "p0": "P0-06",
      "kind": "cleanup_partial_failure",
      "input": {
        "class": "TEMP_SIMULATION",
        "objectDeletion": "SUCCEEDED",
        "metadataDeletion": "FAILED_RETRYABLE"
      },
      "expected": {
        "state": "OBJECT_DELETED",
        "retryMetadataDeletion": true,
        "noOrphanAccessibleObject": true
      },
      "assertions": [
        "cross-store deletion is not assumed atomic"
      ]
    },
    {
      "id": "P0-07A",
      "p0": "P0-07",
      "kind": "family_variant_qualification",
      "input": {
        "family": "INV-01",
        "requiredVariants": [
          {
            "code": "NPV",
            "qualified": true
          },
          {
            "code": "XNPV",
            "qualified": false
          }
        ]
      },
      "expected": {
        "familyQualification": "PARTIAL",
        "npvAvailable": true,
        "xnpvAvailable": false
      },
      "assertions": [
        "qualified NPV cannot qualify XNPV"
      ]
    },
    {
      "id": "P0-07B",
      "p0": "P0-07",
      "kind": "independent_economic_golden",
      "input": {
        "method": "CON-01",
        "currency": "KZT",
        "values": {
          "SKU-A": 500,
          "SKU-B": 300,
          "SKU-C": 150,
          "SKU-D": 50
        }
      },
      "expected": {
        "total": 1000,
        "shares": [
          0.5,
          0.3,
          0.15,
          0.05
        ],
        "cumulative": [
          0.5,
          0.8,
          0.95,
          1
        ]
      },
      "assertions": [
        "expectations independent of Java code",
        "consistent decimal arithmetic"
      ]
    },
    {
      "id": "P0-07C",
      "p0": "P0-07",
      "kind": "zero_denominator",
      "input": {
        "method": "FIN-04",
        "ratio": "CURRENT_RATIO",
        "currentAssets": 400,
        "currentLiabilities": 0
      },
      "expected": {
        "resultStatus": "NOT_COMPUTABLE",
        "numericValue": null
      },
      "assertions": [
        "no Infinity NaN or misleading zero"
      ]
    },
    {
      "id": "P0-SEC-01",
      "p0": "P0-02/P0-03",
      "kind": "tenant_isolation",
      "input": {
        "tokenTenant": "demo-a",
        "requestedTenant": "demo-b",
        "reportId": "report-b"
      },
      "expected": {
        "httpStatus": 403,
        "reportPayloadExposed": false,
        "cacheHitExposed": false
      },
      "assertions": [
        "authorization required on cache read and report access"
      ]
    },
    {
      "id": "P0-RPT-01",
      "p0": "P0-03/P0-04",
      "kind": "stable_core_report",
      "input": {
        "factRevision": "r1",
        "requestedModes": [
          "CORE",
          "CORE_WITH_ML"
        ],
        "coreFacts": {
          "assets": 1000,
          "liabilities": 500,
          "equity": 500
        }
      },
      "expected": {
        "coreValuesEqualAcrossModes": true,
        "coreSnapshotIdIdentical": true,
        "mlCanBeUnavailable": true
      },
      "assertions": [
        "same input => same CORE numbers"
      ]
    },
    {
      "id": "P0-DATA-01",
      "p0": "P0-06",
      "kind": "source_retention",
      "input": {
        "class": "APPROVED_FACTS",
        "createdAt": "2026-01-01T00:00:00Z",
        "now": "2026-02-01T00:00:00Z",
        "temporaryDefaultRetentionDays": 30
      },
      "expected": {
        "eligible": false,
        "reason": "NOT_TEMPORARY_DATA"
      },
      "assertions": [
        "approved facts excluded from 30d cleanup"
      ]
    }
  ]
}
